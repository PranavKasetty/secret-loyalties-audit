__pycache__/
*.pyc
sl_audit_results.zip
bundle/
.kaggle_job/
.env

# Cygwin/MSYS crash dumps from the Bash tool on Windows
*.stackdump

# Notebooks downloaded back from Kaggle with cell outputs embedded. These are
# run artefacts, not source: 100KB+ each, they churn on every run, and the
# source of truth is scripts/kaggle_run.py which regenerates the notebook.
sl-audit-probe-downloaded-with-outputs*.ipynb

# Model outputs stay out of git. transcripts.jsonl and labeled.jsonl hold
# unredacted completions naming real politicians; REPORT.md quotes only
# mechanically-redacted fragments but is still derived from them. Share these
# with the submission directly rather than publishing them.
# repo_identity.json is exempt: sha256 shard hashes only, no model output, and
# it is the evidence for the organism-C finding cited in the README.
results/*
!results/repo_identity.json
# The figure is a derived summary statistic, not a model output.
!results/figure1_fire_rates.png
!results/fire_rates.md
REPORT.md
!results/figure2_depth_profile.png
!results/lens_margins.json
sl-audit-BASE-LENS.ipynb
SUPPLEMENT.md
sl-audit-*-downloaded-with-outputs.ipynb
